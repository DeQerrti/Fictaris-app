{
  "name": "fictaris",
  "version": "0.3.3",
  "private": true,
  "description": "Fictaris — инструмент для писателей и мастеров миров. Настольное приложение: данные лежат папкой на твоём диске.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mobile": "esbuild mobile/src/main.js --bundle --format=iife --outfile=app/js/mobile.bundle.js --minify --legal-comments=none",
    "mobile:sync": "npm run build:mobile && npx cap sync android"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
  "appId": "ru.fictaris.app",
  "productName": "Fictaris",
  "artifactName": "Fictaris-Setup-${version}.${ext}",
  "directories": {
    "output": "dist"
  },
    "files": [
      "app/**/*",
      "core/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "DeQerrti",
      "repo": "Fictaris-app"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "app/icons/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "app/icons/icon-512.png"
    }
  }
}
